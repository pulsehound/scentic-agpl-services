# scentic-agpl-services environment variables
# Copy to .env and fill in real values
# NEVER commit .env files to git

# ── Gateway ────────────────────────────────────────────────────────────────
# The gateway is the only Scentic-facing service
GATEWAY_PORT=3101
NODE_ENV=development
LOG_LEVEL=info

# Public base URL of the gateway (used in source-offer metadata, external-facing URLs)
SCENTIC_GATEWAY_PUBLIC_BASE_URL="http://localhost:3101"

# Internal base URL of the gateway (Scentic core calls this; MUST be a private
# network URL in production — RFC 1918 / localhost / *.local / *.internal)
SCENTIC_GATEWAY_INTERNAL_BASE_URL="http://localhost:3101"

# Shared HMAC secret used to verify service-to-service requests from Scentic core.
# Scentic core sends this in the Authorization: Bearer header (timestamp + nonce
# + signature scheme). MUST be a strong random value in production.
SCENTIC_SHARED_HMAC_SECRET=""

# Webhook target URL on Scentic core that the gateway dispatches events to.
# Required in production. Example: http://scentic-core.internal/api/agpl/webhooks/events
SCENTIC_WEBHOOK_TARGET_URL=""

# HMAC secret used to sign webhook payloads dispatched from this gateway to
# Scentic core. MUST be a strong random value in production.
SCENTIC_WEBHOOK_HMAC_SECRET=""

# Optional persistent store for the gateway mapping/event tables.
# If unset, the gateway uses an in-memory store (dev only).
# SQLite (single-instance): sqlite:///var/lib/gateway/gateway.db
# Postgres (multi-instance): postgresql://user:pass@host:5432/gateway
GATEWAY_DATABASE_URL=""

# ── Kimai ──────────────────────────────────────────────────────────────────
# Kimai database
KIMAI_DATABASE_URL="*******************************************/kimai?charset=utf8mb4&serverVersion=10.11.4-MariaDB"
KIMAI_APP_ENV=prod
KIMAI_APP_SECRET=""
KIMAI_MAILER_FROM="kimai@scentic-test.com"
KIMAI_MAILER_URL="null://null"
KIMAI_CORS_ALLOW_ORIGIN="^https?://localhost(:[0-9]+)?$"

# Kimai admin bootstrap
KIMAI_ADMIN_USER="admin"
KIMAI_ADMIN_EMAIL="admin@scentic-test.com"
KIMAI_ADMIN_PASSWORD=""

# Kimai API access (gateway uses API tokens to talk to Kimai).
# Base URL MUST be a private network URL in production.
KIMAI_BASE_URL="http://localhost:8001"

# Kimai admin username + API token used by the gateway as the fallback
# credential when a per-user Kimai API token is not yet provisioned.
# MUST be set to a strong non-placeholder value in production.
KIMAI_ADMIN_USERNAME="admin"
KIMAI_ADMIN_API_TOKEN=""

# Default activity name used when syncing time entries without an explicit
# activity mapping.
KIMAI_DEFAULT_ACTIVITY_NAME="General"

# When true, the Kimai service replaces sensitive customer/project names with
# confidential labels before sending them to Kimai.
KIMAI_USE_CONFIDENTIAL_LABELS="false"

# ── OpenSign ───────────────────────────────────────────────────────────────
# OpenSign server (AGPL-02 scope — gateway-side OpenSign integration config)
# Master switch for the OpenSign integration. When false, signature routes
# return 503. When true, production validation enforces all OPENSIGN_* reqs.
OPENSIGN_ENABLED="false"

# OpenSign Parse Server REST base URL. The gateway appends /functions/<name>
# and /classes/<className>. MUST be a private network URL in production.
# Note: OPENSIGN_SERVER_URL below is the OpenSign server's own SERVER_URL;
# the gateway uses OPENSIGN_BASE_URL to reach Parse REST.
OPENSIGN_BASE_URL="http://localhost:8080/app"
OPENSIGN_APP_ID="opensign"
OPENSIGN_MASTER_KEY=""

# OpenSign admin account used by the gateway to log in and obtain a session
# token. MUST be strong non-placeholder values when OPENSIGN_ENABLED=true in
# production.
OPENSIGN_ADMIN_EMAIL="admin@opensign.local"
OPENSIGN_ADMIN_PASSWORD=""

# Polling interval (seconds) for getDocument on active workflows. Lower
# values reduce completion-detection latency at the cost of more upstream
# calls. Default 30.
OPENSIGN_POLL_INTERVAL_SECONDS="30"

# Maximum wall-clock seconds the gateway will keep polling a workflow before
# marking it FAILED/EXPIRED if it has not reached a terminal state. Default
# 86400 (24h).
OPENSIGN_COMPLETION_TIMEOUT_SECONDS="86400"

# OpenSign server-side vars (set on the OpenSign container, not the gateway)
OPENSIGN_SERVER_URL="http://localhost:8080/app"
OPENSIGN_MONGODB_URI="mongodb://localhost:27018/opensign"
OPENSIGN_PUBLIC_URL="http://localhost:3000"

# OpenSign file storage (S3-compatible or local)
# Set USE_LOCAL=TRUE for local filesystem storage
USE_LOCAL=TRUE
# DO_SPACE=""
# DO_ENDPOINT=""
# DO_BASEURL=""
# DO_ACCESS_KEY_ID=""
# DO_SECRET_ACCESS_KEY=""
# DO_REGION=""

# OpenSign email (Mailgun or SMTP)
# Mailgun:
# MAILGUN_API_KEY=""
# MAILGUN_DOMAIN=""
# MAILGUN_SENDER=""
# SMTP:
# SMTP_ENABLE="true"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER_EMAIL=""
# SMTP_PASS=""

# OpenSign PDF signing certificate
OPENSIGN_PFX_BASE64=""
OPENSIGN_PASS_PHRASE=""

# ── Production requirements ────────────────────────────────────────────────
# - All secrets must come from a secret manager (GCloud Secret Manager, Vault)
# - SCENTIC_SHARED_HMAC_SECRET must be a strong random value
# - SCENTIC_WEBHOOK_HMAC_SECRET must be a strong random value
# - KIMAI_ADMIN_API_TOKEN must be a strong random value
# - KIMAI_APP_SECRET must be a strong random value
# - OPENSIGN_MASTER_KEY must be a strong random value (when OPENSIGN_ENABLED=true)
# - OPENSIGN_ADMIN_PASSWORD must be a strong random value (when OPENSIGN_ENABLED=true)
# - OPENSIGN_BASE_URL must be a private network URL (when OPENSIGN_ENABLED=true)
# - SCENTIC_GATEWAY_INTERNAL_BASE_URL must be a private network URL
# - KIMAI_BASE_URL must be a private network URL
# - Database passwords must be strong and unique
# - No secrets in this file in production
