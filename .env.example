# scentic-agpl-services environment variables
# Copy to .env and fill in real values
# NEVER commit .env files to git

# ── Gateway ────────────────────────────────────────────────────────────────
# The gateway is the only Scentic-facing service
GATEWAY_PORT=3101
GATEWAY_NODE_ENV=development

# Service-to-service auth between Scentic core and this gateway
# Scentic sends this in the X-Scentic-Service-Token header
SCENTIC_SERVICE_TOKEN=""

# Webhook signing secret for callbacks from this gateway to Scentic core
# Used to sign all webhook payloads sent to Scentic
GATEWAY_WEBHOOK_SECRET=""

# Scentic core base URL (for calling back Scentic webhook endpoints)
SCENTIC_CORE_URL="http://localhost:3100"

# ── Kimai ──────────────────────────────────────────────────────────────────
# Kimai database
KIMAI_DATABASE_URL="mysql://kimai:kimai_password@127.0.0.1:3306/kimai?charset=utf8mb4&serverVersion=10.11.4-MariaDB"
KIMAI_APP_ENV=prod
KIMAI_APP_SECRET=""
KIMAI_MAILER_FROM="kimai@scentic-test.com"
KIMAI_MAILER_URL="null://null"
KIMAI_CORS_ALLOW_ORIGIN="^https?://localhost(:[0-9]+)?$"

# Kimai admin bootstrap
KIMAI_ADMIN_USER="admin"
KIMAI_ADMIN_EMAIL="admin@scentic-test.com"
KIMAI_ADMIN_PASSWORD=""

# Kimai API access (gateway uses API tokens to talk to Kimai)
# Created per-Firm in Kimai; stored in the gateway's mapping table
# KIMAI_API_BASE_URL="http://localhost:8001"

# ── OpenSign ───────────────────────────────────────────────────────────────
# OpenSign server
OPENSIGN_APP_ID=""
OPENSIGN_MASTER_KEY=""
OPENSIGN_SERVER_URL="http://localhost:8080/app"
OPENSIGN_MONGODB_URI="mongodb://localhost:27018/opensign"
OPENSIGN_PUBLIC_URL="http://localhost:3000"

# OpenSign file storage (S3-compatible or local)
# Set USE_LOCAL=TRUE for local filesystem storage
USE_LOCAL=TRUE
# DO_SPACE=""
# DO_ENDPOINT=""
# DO_BASEURL=""
# DO_ACCESS_KEY_ID=""
# DO_SECRET_ACCESS_KEY=""
# DO_REGION=""

# OpenSign email (Mailgun or SMTP)
# Mailgun:
# MAILGUN_API_KEY=""
# MAILGUN_DOMAIN=""
# MAILGUN_SENDER=""
# SMTP:
# SMTP_ENABLE="true"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER_EMAIL=""
# SMTP_PASS=""

# OpenSign PDF signing certificate
OPENSIGN_PFX_BASE64=""
OPENSIGN_PASS_PHRASE=""

# ── Production requirements ────────────────────────────────────────────────
# - All secrets must come from a secret manager (GCloud Secret Manager, Vault)
# - GATEWAY_WEBHOOK_SECRET must be a strong random value
# - SCENTIC_SERVICE_TOKEN must be a strong random value
# - OPENSIGN_MASTER_KEY must be a strong random value
# - KIMAI_APP_SECRET must be a strong random value
# - Database passwords must be strong and unique
# - No secrets in this file in production
