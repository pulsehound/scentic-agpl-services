# scentic-agpl-services — Gateway Dockerfile (LOCAL DEVELOPMENT ONLY)
# Builds the Gateway service for the local docker-compose stack.
# NOT for production. Production uses Cloud Run (see deploy/gcloud/).
#
# AGPL-05: Uses Postgres (pg, pure JS) instead of SQLite (better-sqlite3, native).
# No native module compilation needed — pg is pure JavaScript.

FROM node:20-alpine

WORKDIR /app/gateway

# Copy gateway package.json and install deps with npm
# pg is pure JS — no build tools or native compilation needed
COPY gateway/package.json ./
RUN npm install

# Copy gateway source and build
COPY gateway/ ./
RUN ./node_modules/.bin/tsc

# Copy non-TS assets (schema files) to dist
RUN cp src/storage/postgres-schema.sql dist/storage/postgres-schema.sql
RUN cp src/storage/schema.sql dist/storage/schema.sql

EXPOSE 3101

# Run compiled output
CMD ["node", "dist/server.js"]
