# Rendered by the nginx image's entrypoint: ${UPSTREAM_PORT} is the application's port on localhost.
server {
    listen 8080;
    http2 on;

    client_max_body_size 0;
    client_body_buffer_size 1m;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_http_version 1.1;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    location / {
        proxy_pass http://127.0.0.1:${UPSTREAM_PORT};
        proxy_set_header Host $host;
        # Cloud Run's own X-Forwarded-For names the client first; kept as it arrived so the
        # application still reads the signer's address, not this proxy's.
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
    }
}
