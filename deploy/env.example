# scentic-agpl-services deployment environment template
# Copy relevant values to your deployment environment (GCloud Secret Manager, docker env, etc.)
# NEVER commit actual secret values

# ── Gateway ────────────────────────────────────────────────────────────────
GATEWAY_PORT=3101
GATEWAY_NODE_ENV=production

# Service-to-service auth (Scentic → Gateway). Scentic sends this in the
# X-Scentic-Signature HMAC header (canonical string per docs/SCENTIC_INTERFACE_SPEC.md §3.1).
SCENTIC_SHARED_HMAC_SECRET=""          # From Secret Manager (alias: SCENTIC_SERVICE_TOKEN)

# Webhook dispatch (Gateway → Scentic). The gateway signs outbound webhooks
# with this secret (X-Gateway-Signature: sha256=<hex>). MUST be distinct from
# SCENTIC_SHARED_HMAC_SECRET.
SCENTIC_WEBHOOK_HMAC_SECRET=""         # From Secret Manager (alias: GATEWAY_WEBHOOK_SECRET)

# Scentic core webhook receiver URL. MUST be a private network URL in production.
# Example: http://scentic-core.internal/api/agpl/webhooks/events
SCENTIC_WEBHOOK_TARGET_URL=""          # From Secret Manager / env (alias: SCENTIC_CORE_URL + /api/agpl/webhooks/events)

# Optional persistent store for the gateway mapping/event tables.
# SQLite (single-instance): sqlite:///var/lib/gateway/gateway.db
# Postgres (multi-instance): ********************************/gateway
GATEWAY_DATABASE_URL=""

# ── Durable storage (AGPL-04/05) ───────────────────────────────────────────
# Store type: memory (dev/test), sqlite (bare-metal local), postgres (Docker/prod)
GATEWAY_STORE_TYPE="postgres"
# Path to SQLite database file (only used when GATEWAY_STORE_TYPE=sqlite)
GATEWAY_SQLITE_PATH="./gateway-state.db"
# Allow SQLite in production (not recommended; use postgres for production)
GATEWAY_ALLOW_SQLITE_IN_PRODUCTION="false"
# Postgres connection string (required when GATEWAY_STORE_TYPE=postgres)
# Format: postgres://user:password@host:port/dbname
GATEWAY_DATABASE_URL=""
# Postgres SSL mode: disable, require, verify-ca, verify-full (default: disable)
GATEWAY_POSTGRES_SSL_MODE="disable"
# Redis URL for shared nonce store (optional — Postgres is sufficient for multi-instance)
GATEWAY_REDIS_URL=""

# ── Webhook dispatch tuning (optional) ─────────────────────────────────────
SCENTIC_WEBHOOK_MAX_RETRIES="5"
SCENTIC_WEBHOOK_INITIAL_BACKOFF_MS="5000"
SCENTIC_WEBHOOK_MAX_BACKOFF_MS="600000"
SCENTIC_WEBHOOK_TIMEOUT_MS="30000"

# ── Kimai ──────────────────────────────────────────────────────────────────
KIMAI_DATABASE_URL=""         # Cloud SQL MySQL connection string
KIMAI_APP_ENV=prod
KIMAI_APP_SECRET=""           # From Secret Manager
KIMAI_MAILER_FROM=""
KIMAI_MAILER_URL=""
KIMAI_CORS_ALLOW_ORIGIN=""
KIMAI_ADMIN_USER=""
KIMAI_ADMIN_EMAIL=""
KIMAI_ADMIN_PASSWORD=""       # From Secret Manager

# Kimai admin API token used by the gateway as the fallback credential when
# a per-user Kimai API token is not yet provisioned. From Secret Manager.
KIMAI_ADMIN_API_TOKEN=""
KIMAI_DEFAULT_ACTIVITY_NAME="General"
KIMAI_USE_CONFIDENTIAL_LABELS="true"   # sanitize customer/project names in production

# ── OpenSign ───────────────────────────────────────────────────────────────
# Gateway-side OpenSign integration env vars (AGPL-02)
OPENSIGN_ENABLED="true"
OPENSIGN_BASE_URL=""            # Internal URL of OpenSign Parse REST (e.g. http://opensign.internal:8081/app). MUST be private.
OPENSIGN_APP_ID=""              # Parse Application ID (not secret, but managed)
OPENSIGN_MASTER_KEY=""          # From Secret Manager
OPENSIGN_ADMIN_EMAIL=""         # OpenSign admin email used by gateway to log in
OPENSIGN_ADMIN_PASSWORD=""      # From Secret Manager
OPENSIGN_POLL_INTERVAL_SECONDS="30"
OPENSIGN_COMPLETION_TIMEOUT_SECONDS="86400"

# OpenSign server-side env (set on the OpenSign container, not the gateway)
OPENSIGN_SERVER_URL=""          # Internal URL
OPENSIGN_MONGODB_URI=""         # MongoDB Atlas or self-hosted
OPENSIGN_PUBLIC_URL=""          # Public URL for signing pages

# OpenSign storage
USE_LOCAL=FALSE
DO_SPACE=""                   # GCS bucket name
DO_ENDPOINT=""                # GCS endpoint
DO_ACCESS_KEY_ID=""           # From Secret Manager
DO_SECRET_ACCESS_KEY=""       # From Secret Manager
DO_REGION=""

# OpenSign email
MAILGUN_API_KEY=""            # From Secret Manager (or use SMTP)
MAILGUN_DOMAIN=""
MAILGUN_SENDER=""
# SMTP_ENABLE="true"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER_EMAIL=""
# SMTP_PASS=""

# OpenSign PDF signing
OPENSIGN_PFX_BASE64=""        # From Secret Manager
OPENSIGN_PASS_PHRASE=""       # From Secret Manager
