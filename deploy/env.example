# scentic-agpl-services deployment environment template
# Copy relevant values to your deployment environment (GCloud Secret Manager, docker env, etc.)
# NEVER commit actual secret values

# ── Gateway ────────────────────────────────────────────────────────────────
GATEWAY_PORT=3101
GATEWAY_NODE_ENV=production
SCENTIC_SERVICE_TOKEN=""      # From Secret Manager
GATEWAY_WEBHOOK_SECRET=""     # From Secret Manager
SCENTIC_CORE_URL=""           # Internal URL of Scentic core

# ── Kimai ──────────────────────────────────────────────────────────────────
KIMAI_DATABASE_URL=""         # Cloud SQL MySQL connection string
KIMAI_APP_ENV=prod
KIMAI_APP_SECRET=""           # From Secret Manager
KIMAI_MAILER_FROM=""
KIMAI_MAILER_URL=""
KIMAI_CORS_ALLOW_ORIGIN=""
KIMAI_ADMIN_USER=""
KIMAI_ADMIN_EMAIL=""
KIMAI_ADMIN_PASSWORD=""       # From Secret Manager

# ── OpenSign ───────────────────────────────────────────────────────────────
# Gateway-side OpenSign integration env vars (AGPL-02)
OPENSIGN_ENABLED="true"
OPENSIGN_BASE_URL=""            # Internal URL of OpenSign Parse REST (e.g. http://opensign.internal:8081/app). MUST be private.
OPENSIGN_APP_ID=""              # Parse Application ID (not secret, but managed)
OPENSIGN_MASTER_KEY=""          # From Secret Manager
OPENSIGN_ADMIN_EMAIL=""         # OpenSign admin email used by gateway to log in
OPENSIGN_ADMIN_PASSWORD=""      # From Secret Manager
OPENSIGN_POLL_INTERVAL_SECONDS="30"
OPENSIGN_COMPLETION_TIMEOUT_SECONDS="86400"

# OpenSign server-side env (set on the OpenSign container, not the gateway)
OPENSIGN_SERVER_URL=""          # Internal URL
OPENSIGN_MONGODB_URI=""         # MongoDB Atlas or self-hosted
OPENSIGN_PUBLIC_URL=""          # Public URL for signing pages

# OpenSign storage
USE_LOCAL=FALSE
DO_SPACE=""                   # GCS bucket name
DO_ENDPOINT=""                # GCS endpoint
DO_ACCESS_KEY_ID=""           # From Secret Manager
DO_SECRET_ACCESS_KEY=""       # From Secret Manager
DO_REGION=""

# OpenSign email
MAILGUN_API_KEY=""            # From Secret Manager (or use SMTP)
MAILGUN_DOMAIN=""
MAILGUN_SENDER=""
# SMTP_ENABLE="true"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER_EMAIL=""
# SMTP_PASS=""

# OpenSign PDF signing
OPENSIGN_PFX_BASE64=""        # From Secret Manager
OPENSIGN_PASS_PHRASE=""       # From Secret Manager
