# Environment files
.env
.env.local
.env.*.local

# Secrets
*.key
*.pem
*.pfx
*.p12
secrets/
google-service-account.json

# Node.js
node_modules/
dist/
build/
.cache/
.turbo/

# Vendor upstream repos (cloned by scripts/setup.sh, not committed)
# Upstream Kimai and OpenSign are public at:
#   https://github.com/kimai/kimai
#   https://github.com/OpenSignLabs/OpenSign
vendor/kimai/
vendor/opensign/

# PHP / Composer (if vendor repos are present locally)
vendor/kimai/var/
vendor/kimai/.env.local
vendor/opensign/node_modules/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Docker
docker-compose.override.yml

# Uploads / temp
uploads/
tmp/

# Terraform working directory: provider binaries are large and re-downloaded
# by `terraform init`. The lock file is committed; the plugins are not.
deploy/terraform/.terraform/
deploy/terraform/*.tfstate
deploy/terraform/*.tfstate.*
deploy/terraform/*.tfvars
deploy/terraform/tfplan*

# The staging inputs are the exception, committed on purpose: they name secrets
# rather than carrying them, and without them the stack cannot be rebuilt from
# the configuration alone — which is the acceptance test. Any tfvars file that
# does hold a credential stays ignored by the rule above.
!deploy/terraform/staging.auto.tfvars
